# RelaxDiff environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# RelaxDiff talks to any OpenAI-compatible LLM endpoint (OpenAI, DeepSeek,
# Together, Groq, Fireworks, Ollama, ...). Set the three variables below
# to point at the provider you prefer.

RELAXDIFF_LLM_API_KEY=
RELAXDIFF_LLM_MODEL=deepseek-chat
RELAXDIFF_LLM_BASE_URL=https://api.deepseek.com

# Examples for other providers:
#   OpenAI   → MODEL=gpt-4o-mini             BASE_URL=https://api.openai.com/v1
#   Together → MODEL=meta-llama/Llama-3-...  BASE_URL=https://api.together.xyz/v1
#   Groq     → MODEL=llama-3.1-70b-versatile BASE_URL=https://api.groq.com/openai/v1
#   Ollama   → MODEL=llama3                  BASE_URL=http://localhost:11434/v1
