# RelaxDiff environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# DeepSeek API key (OpenAI-compatible endpoint).
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: override the LLM model / endpoint without editing config.py.
# RELAXDIFF_LLM_MODEL=deepseek-chat
# RELAXDIFF_LLM_BASE_URL=https://api.deepseek.com
