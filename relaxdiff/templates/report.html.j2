<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ payload.title }}</title>
  <script src="{{ payload.threedmol_url }}"></script>
  <style>{% include "style.css" %}</style>
</head>
<body>

<header>
  <div>
    <div class="title">{{ payload.title }}</div>
    <div class="subtitle">
      {{ payload.geometry.formula }} · {{ payload.geometry.n_atoms }} atoms ·
      RMSD {{ "%.3f"|format(payload.geometry.rmsd) }} Å ·
      ΔV {{ "%+.1f"|format(payload.geometry.cell.volume_change_frac * 100) }}%
    </div>
  </div>
  <div class="severity-chip severity-{{ payload.severity_overall }}">
    {{ payload.severity_overall }}
  </div>
</header>

<main>
  <section class="viewer-card">
    <div class="viewer-controls">
      <button data-mode="before">Before</button>
      <button data-mode="after">After</button>
      <button data-mode="overlay" class="active">Overlay</button>
      <button data-mode="diff">Diff heatmap</button>
      <span class="divider"></span>
      <button id="toggle-arrows" class="active">Displacement arrows</button>
    </div>
    <div id="viewer"></div>
    <div class="legend">
      <span><span class="legend-dot" style="background:#cf222e"></span>arrow &gt; 1.0 Å</span>
      <span><span class="legend-dot" style="background:#bf8700"></span>arrow &gt; 0.3 Å</span>
      <span><span class="legend-dot" style="background:#0969da"></span>arrow smaller</span>
      <span style="color: var(--text-dim);">·</span>
      <span style="color: var(--text-dim);">Overlay: before = small ghost spheres, after = full balls &amp; sticks.</span>
      <span style="color: var(--text-dim);">Diff heatmap: after only, colored by per-atom displacement (blue → red).</span>
    </div>
  </section>

  <aside class="sidebar">
    <div class="card narrative">
      <h3>Narrative</h3>
      {{ payload.narrative_html|safe }}
    </div>

    <div class="card">
      <h3>Findings ({{ payload.diagnosis.findings|length }})</h3>
      {% for f in payload.diagnosis.findings %}
      <div class="finding">
        <div class="pill {{ f.severity }}"></div>
        <div class="body">
          <div class="rule">{{ f.rule }}</div>
          <div class="short">{{ f.short }}</div>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="card">
      <h3>Summary stats</h3>
      <div class="stats">
        <div class="stat-label">Max displacement</div>
        <div class="stat-value">{{ "%.3f"|format(payload.geometry.max_displacement) }} Å</div>
        <div class="stat-label">RMSD</div>
        <div class="stat-value">{{ "%.4f"|format(payload.geometry.rmsd) }} Å</div>
        <div class="stat-label">Volume Δ</div>
        <div class="stat-value">{{ "%+.2f"|format(payload.geometry.cell.volume_change_frac * 100) }}%</div>
        <div class="stat-label">Space group</div>
        <div class="stat-value">{{ payload.symmetry.before.space_group_symbol }} → {{ payload.symmetry.after.space_group_symbol }}</div>
        <div class="stat-label">Bonds broken</div>
        <div class="stat-value">{{ payload.diagnosis.summary_stats.bonds_broken }}</div>
        <div class="stat-label">Bonds formed</div>
        <div class="stat-value">{{ payload.diagnosis.summary_stats.bonds_formed }}</div>
      </div>
    </div>
  </aside>
</main>

<details>
  <summary>Per-atom displacement table</summary>
  <table>
    <thead>
      <tr>
        <th>#</th><th>Element</th><th>Displacement (Å)</th><th>CN before</th><th>CN after</th><th>ΔCN</th>
      </tr>
    </thead>
    <tbody>
      {% for a in payload.geometry.per_atom %}
      <tr>
        <td>{{ a.index }}</td>
        <td>{{ a.element }}</td>
        <td>{{ "%.3f"|format(a.displacement) }}</td>
        <td>{{ a.cn_before }}</td>
        <td>{{ a.cn_after }}</td>
        <td>{% if a.cn_change != 0 %}{{ "%+d"|format(a.cn_change) }}{% else %}—{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</details>

<details>
  <summary>Bond changes ({{ payload.geometry.bond_changes|length }})</summary>
  {% if payload.geometry.bond_changes %}
  <table>
    <thead>
      <tr><th>i</th><th>j</th><th>Pair</th><th>Before (Å)</th><th>After (Å)</th><th>Δ (Å)</th><th>Kind</th></tr>
    </thead>
    <tbody>
      {% for b in payload.geometry.bond_changes %}
      <tr>
        <td>{{ b.i }}</td>
        <td>{{ b.j }}</td>
        <td>{{ b.element_i }}–{{ b.element_j }}</td>
        <td>{% if b.length_before is not none %}{{ "%.3f"|format(b.length_before) }}{% else %}—{% endif %}</td>
        <td>{% if b.length_after is not none %}{{ "%.3f"|format(b.length_after) }}{% else %}—{% endif %}</td>
        <td>{% if b.delta is not none %}{{ "%+.3f"|format(b.delta) }}{% else %}—{% endif %}</td>
        <td>{{ b.kind }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div style="color: var(--text-dim);">No notable bond changes.</div>
  {% endif %}
</details>

<footer>
  Generated by <a href="https://github.com/zoe/relaxdiff">RelaxDiff</a>.
  Drop two structures, get a sanity check.
</footer>

<script id="relaxdiff-payload" type="application/json">{{ payload_json|safe }}</script>
<script>
  window.__RELAXDIFF__ = JSON.parse(document.getElementById("relaxdiff-payload").textContent);
</script>
<script>{% include "viewer.js" %}</script>

</body>
</html>
